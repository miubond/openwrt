{
  "name": "mp716-web",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vue-tsc -b && vite build --mode production",
    "build:web": "npm run build && node firmware/scripts/stage-web-overlay.mjs",
    "build:mp716-test": "vue-tsc -b && vite build --mode mp716-test && node firmware/scripts/verify-production-bundle.mjs",
    "deploy:router": "npm run build:mp716-test && powershell -ExecutionPolicy Bypass -File firmware/scripts/deploy-wget-mp716.ps1",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts,.vue",
    "factory:hyid": "node firmware/scripts/dump-hyid-registry.mjs",
    "factory:catalog": "node firmware/scripts/dump-hyid-registry.mjs && node firmware/scripts/export-cgi-api-catalog.mjs",
    "factory:api-doc": "node firmware/scripts/export-factory-api-doc.mjs && node firmware/scripts/export-cgi-api-catalog.mjs",
    "factory:analyze": "node firmware/scripts/dump-hyid-registry.mjs && node firmware/scripts/analyze-factory-staging.mjs",
    "factory:parse": "node firmware/scripts/parse-factory-routes.mjs",
    "factory:probe-upgrade": "node firmware/scripts/probe-factory-upgrade.mjs",
    "build:openwrt": "vue-tsc -b && vite build --mode openwrt",
    "test:ui:lp": "node tests/unit/lp-render-check.mjs"
  },
  "dependencies": {
    "@lucide/vue": "^1.72.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "sass": "^1.108.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
