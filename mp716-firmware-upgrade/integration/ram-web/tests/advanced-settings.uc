// Fixture-only test. The host harness redirects every configuration path.
import { route_system, validate_time, validate_schedule } from '../system-admin.uc';
import { diagnostic_args } from '../diagnostics.uc';
import { defaults, validate_vpn, validate_openvpn, ppp_quote, mask_bits } from '../vpn-config.uc';
import { get_task } from '../admin-state.uc';
import { readfile } from 'fs';
let root=getenv('MP716_ADVANCED_FIXTURE');
if(!match(root || '',/^\/tmp\/mp716-advanced-tests\.[A-Za-z0-9]+\/fixture$/))die('Expected isolated fixture');
let owner='aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa',passed=[];
function assert(ok,message){if(!ok)die(message);}
function rejects(name,fn){let failed=false;try{fn();}catch(e){failed=true;}assert(failed,name);push(passed,name);}
rejects('ping_shell_argument_rejected',()=>diagnostic_args({type:'ping',target:'127.0.0.1;reboot',count:1},[]));
rejects('ping_option_rejected',()=>diagnostic_args({type:'ping',target:'--help',count:1},[]));
rejects('foreign_source_rejected',()=>diagnostic_args({type:'ping',target:'example.org',count:1,source:'10.0.0.99'},['192.168.199.1']));
rejects('trace_budget_rejected',()=>diagnostic_args({type:'traceroute',target:'example.org',maxHops:21,timeoutSec:10},[]));
assert(diagnostic_args({type:'ping',target:'example.org',count:1,source:'192.168.199.1'},['192.168.199.1'])[3]=='192.168.199.1','valid source rejected');push(passed,'valid_ping_plan');
rejects('timezone_command_rejected',()=>validate_time({timezone:'UTC;reboot',ntpEnabled:true,ntpServers:['time.example.org']}));
rejects('empty_ntp_rejected',()=>validate_time({timezone:'CST-8',ntpEnabled:true,ntpServers:['','','']}));
rejects('zero_countdown_rejected',()=>validate_schedule({mode:1,remainHour:0,remainMinute:0,hour:0,minute:0,weeks:255}));
rejects('empty_weekdays_rejected',()=>validate_schedule({mode:2,remainHour:0,remainMinute:30,hour:0,minute:0,weeks:0}));
let original=readfile(root+'/config/system');
let r=route_system(null,'POST','system/time',{config:{timezone:'CST-8',ntpEnabled:true,ntpServers:['time.example.org','','']}},owner);
assert(r?.data?.taskId && readfile(root+'/config/system')!=original,'NTP save failed');
get_task(r.data.taskId,owner,'cancel');assert(readfile(root+'/config/system')==original,'NTP rollback failed');push(passed,'ntp_save_exact_rollback');
r=route_system(null,'POST','system/sche-reboot',{config:{mode:2,remainHour:0,remainMinute:30,hour:3,minute:15,weeks:255}},owner);
assert(r?.data?.taskId,'schedule save failed');get_task(r.data.taskId,owner,'cancel');
assert(readfile(root+'/config/mp716_system')==null,'new schedule file remained after rollback');push(passed,'new_package_removed_on_rollback');
let export_response=route_system(null,'POST','system/backup/download',{},owner), exported=export_response?.data;
assert(exported?.contentBase64 && exported.filename,'backup export failed: '+sprintf('%J',export_response));
let backup=json(b64dec(exported.contentBase64));assert(backup.product=='MP716' && backup.files.network,'backup content missing');push(passed,'native_backup_export');
backup.files.Bootloader={contentBase64:b64enc('bad'),mode:0600};
r=route_system(null,'POST','system/restore',{backup:backup},owner);assert(r?.error,'unallowed backup file accepted');push(passed,'backup_non_config_rejected');
r=route_system(null,'POST','system/factory-reset',{confirmToken:'wrong'},owner);assert(r?.error,'reset without confirmation accepted');push(passed,'reset_confirmation_required');
r=route_system(null,'POST','system/password',{oldPassword:'old',newPassword:'short'},owner);assert(r?.error,'short password accepted');push(passed,'invalid_password_rejected');
let server=defaults('xl2tpd');
rejects('l2tp_role_conflict',()=>validate_vpn('xl2tpd',{...server,enabled:true},server,{xl2tp:{enabled:true}}));
rejects('vpn_invalid_pool',()=>validate_vpn('pptpd',{...defaults('pptpd'),endIp:'10.71.62.100'},null,{}));
rejects('vpn_empty_ipsec_key',()=>validate_vpn('xl2tpd',{...server,enabled:true,ipsecEnabled:true},null,{}));
rejects('duplicate_vpn_user',()=>validate_vpn('users',{users:[{type:'all',username:'one',password:'secret',address:'',comment:'',routes:''},{type:'all',username:'one',password:'secret',address:'',comment:'',routes:''}]},null,{}));
rejects('vpn_secret_newline_rejected',()=>validate_vpn('pptp',{...defaults('pptp'),enabled:true,server:'vpn.example.org',username:'one',password:'a\nplugin bad'},null,{}));
assert(mask_bits('255.0.255.0')==null && mask_bits('255.255.255.0')==24,'netmask validation failed');push(passed,'vpn_netmask_validation');
let old={...defaults('pptp'),password:'original-secret'};
assert(validate_vpn('pptp',{...old,password:'********'},old,{}).password=='original-secret','masked secret erased');push(passed,'masked_vpn_secret_preserved');
rejects('openvpn_script_rejected',()=>validate_openvpn('client\nup /tmp/script\n'));
rejects('openvpn_credential_path_rejected',()=>validate_openvpn('client\nca /etc/shadow\n'));
assert(index(validate_openvpn('client\ndev tun\nauth-user-pass secret.txt\n'),'/var/run/mp716-vpn/openvpn.auth')>=0,'OpenVPN auth path not constrained');push(passed,'openvpn_managed_paths');
assert(ppp_quote('a"b')=='"a\\"b"','PPP escaping failed');push(passed,'ppp_secret_escaping');
printf('%J\n',{passed:passed,fixture_only:true});
