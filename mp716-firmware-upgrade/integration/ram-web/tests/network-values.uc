import { address, pool_bounds, rate_delta } from '../network-values.uc';
import { route_admin } from '../admin.uc';
import { get_task } from '../admin-state.uc';
import { cursor } from 'uci';
import { readfile, writefile } from 'fs';
let root=getenv('MP716_ADVANCED_FIXTURE');
if(!match(root || '',/^\/tmp\/mp716-advanced-tests\.[A-Za-z0-9]+\/fixture$/))die('Expected isolated fixture');
let passed=[],owner='aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa';
function assert(ok,name){if(!ok)die(name);push(passed,name);}
assert(address(3232286465)=='192.168.199.1','ipv4_integer_roundtrip');
let p=pool_bounds('10.10.2.1',16);
assert(p.first=='10.10.0.1'&&p.last=='10.10.255.254'&&p.router==513,'pool_16_bounds');
p=pool_bounds('10.10.2.129',25);assert(p.first=='10.10.2.129'&&p.last=='10.10.2.254','pool_25_bounds');
p=pool_bounds('10.10.2.1',30);assert(p.first=='10.10.2.1'&&p.last=='10.10.2.2','pool_30_bounds');
let sample={device:'eth0.2',boot:'boot',ms:1000,rx:100,tx:200};
assert(rate_delta(sample,{...sample,ms:3000,rx:1100,tx:4200}).rxRateBps==500,'measured_receive_rate');
assert(rate_delta(sample,{...sample,ms:3000,rx:1100,tx:4200}).txRateBps==2000,'measured_transmit_rate');
assert(!rate_delta(sample,{...sample,ms:3000,rx:0,tx:0}).ratesReady,'counter_reset_not_negative_rate');
assert(!rate_delta(sample,{...sample,ms:3000,boot:'new'}).ratesReady,'rate_sample_bound_to_boot');
let network="config interface 'lan'\n option device 'br-lan'\n option ipaddr '10.10.2.1/16'\nconfig interface 'wan'\n option device 'eth0.2'\n option proto 'dhcp'\n";
writefile(root+'/config/network',network);
let dhcp=readfile(root+'/config/dhcp');
let result=route_admin(null,'POST','network/dhcp/config',{config:{enabled:true,startIp:'10.10.1.250',endIp:'10.10.1.255',leasetime:'7200'}},owner);
assert(!!result?.data?.taskId,'dhcp_non_24_save');
let c=cursor(root+'/config',root+'/uci');assert(c.get('dhcp','lan','start')=='506'&&c.get('dhcp','lan','limit')=='6','dhcp_cross_octet_offsets');
get_task(result.data.taskId,owner,'cancel');assert(readfile(root+'/config/dhcp')==dhcp,'dhcp_non_24_exact_rollback');
result=route_admin(null,'POST','network/dhcp/config',{config:{enabled:true,startIp:'10.10.1.250',endIp:'10.10.2.2',leasetime:'7200'}},owner);
assert(!!result?.error,'dhcp_router_inside_pool_rejected');
result=route_admin(null,'POST','network/lan/config',{config:{ipv4:'10.10.2.1',netmask:'255.255.255.252'}},owner);
assert(!!result?.data?.taskId,'lan_30_save_adjusts_dhcp');
c=cursor(root+'/config',root+'/uci');assert(c.get('dhcp','lan','start')=='2'&&c.get('dhcp','lan','limit')=='1','lan_30_usable_pool');
get_task(result.data.taskId,owner,'cancel');assert(readfile(root+'/config/network')==network&&readfile(root+'/config/dhcp')==dhcp,'lan_dhcp_atomic_rollback');
printf('%J\n',{passed:passed,fixture_only:true});
