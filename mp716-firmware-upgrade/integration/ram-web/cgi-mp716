#!/bin/sh
# 生产网关。/tmp 在每次开机和固件升级后都是空的，字节码由开机脚本生成。
# 字节码缺失或比源码旧时先编译再执行，避免一直退回源码解释（MT7628 上每次请求约 5 秒）。
S=/usr/share/mp716/httpd.uc
D=/tmp/mp716-ucb
B=$D/httpd.ucb
if [ ! -x /usr/bin/ucode ] || [ ! -r "$S" ]; then
	printf 'Status: 503 Service Unavailable\r\nContent-Type: application/json\r\n\r\n'
	printf '{"ok":false,"code":"NOT_IMPLEMENTED","message":"mp716 production httpd requires ucode","ts":%s}\n' "$(date +%s)"
	exit 0
fi
if [ ! -r "$B" ] || [ "$S" -nt "$B" ]; then
	mkdir -p "$D"
	if command -v flock >/dev/null 2>&1; then
		flock "$D/httpd.lock" -c "/bin/sh /usr/share/mp716/mp716-ucode-compile.sh"
	else
		/bin/sh /usr/share/mp716/mp716-ucode-compile.sh
	fi
fi
if [ -r "$B" ]; then
	exec /usr/bin/ucode "$B"
fi
exec /usr/bin/ucode "$S"
