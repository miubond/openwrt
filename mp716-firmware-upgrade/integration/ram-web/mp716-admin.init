#!/bin/sh /etc/rc.common
START=18
STOP=90
USE_PROCD=1
start_service() {
	/bin/sh /usr/share/mp716/mp716-ucode-compile.sh
	/usr/bin/ucode /usr/share/mp716/admin-tick.uc
	procd_open_instance
	procd_set_param command /bin/sh -c 'T=/tmp/mp716-ucb/admin-tick.ucb; [ -r "$T" ] || T=/usr/share/mp716/admin-tick.uc; while sleep 5; do /usr/bin/ucode "$T"; done'
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
