#!/bin/sh
# 初始化缺失的策略文件。保留已显式配置的设备验收状态。
set -e
. /lib/functions.sh
[ "$(board_name)" = yunxm,mp716 ] || exit 0
mkdir -p /etc/mp716-upgrade
if [ ! -f /etc/mp716-upgrade/upgrade-policy ]; then
	echo production > /etc/mp716-upgrade/upgrade-policy
fi
[ -f /etc/mp716-upgrade/flash-gate ] || printf '%s\n' closed > /etc/mp716-upgrade/flash-gate
[ -f /etc/mp716-upgrade/platform ] || printf '%s\n' unconfirmed > /etc/mp716-upgrade/platform
exit 0
