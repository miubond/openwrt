#!/bin/sh
# Front door for sysupgrade on an OpenWrt image built for MP716.
# Installing this onto the vendor firmware does not make that firmware upgradable.
# Platform format and recovery must both be confirmed. Never calls mtd and never accepts -F.
set -eu

GATE_FILE="${MP716_GATE_FILE:-/etc/mp716-upgrade/flash-gate}"
PLATFORM_FILE="${MP716_PLATFORM_FILE:-/etc/mp716-upgrade/platform}"
if [ -n "${MP716_TEST_ROOT:-}" ]; then
	RESULT_FILE="$MP716_TEST_ROOT/apply-result.json"
else
	RESULT_FILE=/tmp/mp716-upgrade/apply-result.json
fi
APPLY_SERVICES="wpad mp716-vpn sysntpd odhcpd log urngd uhttpd mp716-admin dnsmasq cron miniupnpd"

usage() {
	echo "usage: mp716-sysupgrade identify|verify|plan|apply FILE [--keep-config]" >&2
	exit 1
}

for arg in "$@"; do
	case "$arg" in
		-F|--force|allow-flash-upgrade)
			printf '%s\n' '{"ok":false,"error":"flash_disabled","flash_write":false}'
			exit 24
			;;
	esac
done

[ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage
cmd=$1
file=$2
keep=0
if [ "${3:-}" = "--keep-config" ]; then
	keep=1
elif [ -n "${3:-}" ]; then
	usage
fi

case "$file" in
	*".."*|*/dev/mtd*|*/dev/mtdblock*|*mtdblock*)
		printf '%s\n' '{"ok":false,"error":"path","flash_write":false}'
		exit 23
		;;
esac
case "$file" in
	/*) ;;
	*) file="./$file" ;;
esac
[ -f "$file" ] || {
	printf '%s\n' '{"ok":false,"error":"io","flash_write":false}'
	exit 2
}

if command -v hexdump >/dev/null 2>&1; then
	magic=$(hexdump -v -n 8 -e '1/1 "%02x"' "$file")
else
	magic=$(od -An -t x1 -N 8 "$file" | tr -d ' \n')
fi
kind=unknown
case "$magic" in
	4d50373136555044*) kind=custom ;;
	27051956*) kind=vendor ;;
esac

plan_command() {
	if [ "$keep" -eq 1 ]; then
		printf '%s\n' 'sysupgrade -f <config-and-pending-archive> <verified-payload>'
	else
		printf '%s\n' 'sysupgrade -n -f <pending-only-archive> <verified-payload>'
	fi
}

gate_open() {
	[ -f "$GATE_FILE" ] || return 1
	value=$(tr -d '\r\n' < "$GATE_FILE")
	[ "$value" = "serial-recovery-verified" ]
}

platform_confirmed() {
	[ -f "$PLATFORM_FILE" ] || return 1
	value=$(tr -d '\r\n' < "$PLATFORM_FILE")
	[ "$value" = "confirmed" ]
}

restore_services() {
	if [ -n "${old_min:-}" ]; then
		(echo "$old_min" > /proc/sys/vm/min_free_kbytes) 2>/dev/null || true
	fi
	[ -z "${MP716_TEST_ROOT:-}" ] || return 0
	(
		for svc in uhttpd dnsmasq mp716-admin log sysntpd odhcpd urngd wpad cron miniupnpd mp716-vpn; do
			/etc/init.d/$svc start >/dev/null 2>&1 || true
		done
		wifi up >/dev/null 2>&1 || true
	) >/dev/null 2>&1 &
}

# The web request has already returned "submitted"; the job status API reads this file.
record_failure() {
	mkdir -p "$(dirname "$RESULT_FILE")" 2>/dev/null || true
	printf '%s\n' "$1" > "$RESULT_FILE" 2>/dev/null || true
	printf '%s\n' "$1"
}

apply_failed() {
	restore_services
	case "$file" in /tmp/mp716-firmware-upload-*.mp716upd|/tmp/mp716-firmware-upload-apply.mp716upd) rm -f -- "$file" ;; esac
	record_failure "$1"
}

check_container() {
	case "$kind" in
		unknown)
			printf '%s\n' '{"ok":false,"error":"format","flash_write":false}'
			return 3
			;;
		vendor)
			printf '%s\n' '{"ok":false,"error":"vendor_image_not_audited","flash_write":false}'
			return 9
			;;
	esac
	if ! command -v mp716-upgraded >/dev/null 2>&1; then
		printf '%s\n' '{"ok":false,"error":"checker_missing","flash_write":false}'
		return 1
	fi
	mp716-upgraded check --image "$file" "$@"
}

case "$cmd" in
	identify)
		printf '{"ok":true,"kind":"%s","flash_write":false}\n' "$kind"
		;;
	verify)
		check_container
		;;
	plan)
		printf '{"ok":true,"kind":"%s","command":"%s","flash_write":false}\n' "$kind" "$(plan_command)"
		;;
	apply)
		if ! platform_confirmed; then
			printf '%s\n' '{"ok":false,"error":"platform_unconfirmed","flash_write":false}'
			exit 12
		fi
		if ! gate_open; then
			printf '%s\n' '{"ok":false,"error":"flash_disabled","flash_write":false}'
			exit 24
		fi
		# uhttpd kills the CGI after 60s. Extracting on MT7628 takes longer than that,
		# so the web request only moves the image aside and returns. The child waits
		# until that CGI has exited, then extracts and flashes.
		if [ -z "${MP716_TEST_ROOT:-}" ] && [ -z "${MP716_APPLY_CHILD:-}" ]; then
			stable=/tmp/mp716-firmware-upload-apply.mp716upd
			mv -f "$file" "$stable"
			if [ "$keep" -eq 1 ]; then
				MP716_APPLY_CHILD=1 MP716_GATE_FILE="$GATE_FILE" MP716_PLATFORM_FILE="$PLATFORM_FILE" \
					setsid "$0" apply "$stable" --keep-config >/tmp/sysupgrade-run.log 2>&1 </dev/null &
			else
				MP716_APPLY_CHILD=1 MP716_GATE_FILE="$GATE_FILE" MP716_PLATFORM_FILE="$PLATFORM_FILE" \
					setsid "$0" apply "$stable" >/tmp/sysupgrade-run.log 2>&1 </dev/null &
			fi
			printf '%s\n' '{"ok":true,"flash_write":true,"detail":"submitted"}'
			exit 0
		fi
		if [ -z "${MP716_TEST_ROOT:-}" ]; then
			sleep 3
		fi
		rm -f -- "$RESULT_FILE"
		_payload_kb=$(( $(wc -c < "$file") / 1024 ))
		_tmp_kb=$(df -k /tmp 2>/dev/null | awk 'NR==2 {print $4}')
		_need_tmp_kb=$(( _payload_kb + 512 ))
		if [ -n "$_tmp_kb" ] && [ "$_tmp_kb" -lt "$_need_tmp_kb" ]; then
			apply_failed "{\"ok\":false,\"error\":\"low_tmp\",\"flash_write\":false,\"detail\":\"tmp free ${_tmp_kb}kB < need ${_need_tmp_kb}kB\"}"
			exit 26
		fi
		# The container already sits on tmpfs, so MemAvailable only reaches the extract
		# budget once Wi-Fi and the daemons are gone. hostapd is restarted by netifd,
		# so wpad stop alone does not free it. Ethernet stays up.
		wifi down >/dev/null 2>&1 || true
		for svc in $APPLY_SERVICES; do
			/etc/init.d/$svc stop >/dev/null 2>&1 || true
		done
		sync
		# dash exits on a failed redirect under set -e, even with "|| true".
		# 64MB kernels reserve 8MB via min_free_kbytes, so MemAvailable stays under the
		# payload+8MB budget even when MemFree is large enough to extract the image.
		if [ -z "${MP716_TEST_ROOT:-}" ]; then
			old_min=$(cat /proc/sys/vm/min_free_kbytes 2>/dev/null || printf '%s' 8192)
			(echo 1024 > /proc/sys/vm/min_free_kbytes) 2>/dev/null || true
		fi
		(echo 3 > /proc/sys/vm/drop_caches) 2>/dev/null || true
		# Same budget mp716-upgraded --extract enforces (MP716_UPLOAD_RESERVE_BYTES).
		_need_kb=$(( _payload_kb + 8192 ))
		_avail_kb=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo 2>/dev/null || echo 0)
		if [ -n "$_avail_kb" ] && [ "$_avail_kb" -lt "$_need_kb" ]; then
			apply_failed "{\"ok\":false,\"error\":\"low_memory\",\"flash_write\":false,\"detail\":\"MemAvailable ${_avail_kb}kB < need ${_need_kb}kB\"}"
			exit 25
		fi
		stage=$(mktemp -d /tmp/mp716-sysupgrade.XXXXXX)
		payload="$stage/sysupgrade.bin"
		trap 'rm -rf -- "$stage"' EXIT
		trap 'exit 1' HUP INT TERM
		archive="$stage/config.tgz"
		root="$stage/root"
		set +e
		report=$(check_container --extract "$payload" --pending-state "$stage/sysupgrade.pending")
		status=$?
		set -e
		if [ "$status" -ne 0 ]; then
			apply_failed "$report"
			exit "$status"
		fi
		set -- "$payload"
		if [ "$keep" -eq 0 ]; then
			set -- -n "$@"
		fi
		set +e
		sysupgrade -T "$@"
		status=$?
		set -e
		if [ "$status" -ne 0 ]; then
			apply_failed "{\"ok\":false,\"error\":\"sysupgrade_test\",\"flash_write\":false,\"detail\":\"sysupgrade -T exit ${status}\"}"
			exit "$status"
		fi
		# 64 MB boards cannot hold the uploaded container and the extracted image in tmpfs
		# while procd stages the upgrade; only the verified extract is needed from here on.
		case "$file" in /tmp/mp716-firmware-upload-*.mp716upd|/tmp/mp716-firmware-upload-apply.mp716upd) rm -f -- "$file" ;; esac
		sync
		(echo 3 > /proc/sys/vm/drop_caches) 2>/dev/null || true
		# The web request is still resident. Packing and flashing in this process
		# reboots a 64MB board without writing the image. Exit so uhttpd can
		# answer, then flash once that memory has been released.
		trap - EXIT HUP INT TERM
		cat > "$stage/run.sh" << EOF
#!/bin/sh
sleep $([ -n "${MP716_TEST_ROOT:-}" ] && printf '%s' 0 || printf '%s' 3)
for s in mp716-admin uhttpd dnsmasq miniupnpd cron; do
	/etc/init.d/\$s stop >/dev/null 2>&1 || true
done
sync
(echo 3 > /proc/sys/vm/drop_caches) 2>/dev/null || true
mkdir '$root' || exit 1
if [ '$keep' -eq 1 ]; then
	sysupgrade -b '$archive' || exit 1
	tar -xzf '$archive' -C '$root' || exit 1
fi
mkdir -p '$root/etc/mp716-upgrade'
if [ -f /tmp/mp716-firmware-installed.at ]; then
	cp -f /tmp/mp716-firmware-installed.at '$root/etc/mp716-upgrade/installed.at'
fi
mv -f '$stage/sysupgrade.pending' '$root/etc/mp716-upgrade/sysupgrade.pending'
if [ '$keep' -eq 1 ]; then
	cd '$root' || exit 1
	set --
	for entry in ./* ./.[!.]* ./..?*; do
		[ -e "\$entry" ] || [ -L "\$entry" ] || continue
		set -- "\$@" "\$entry"
	done
	tar -czf '$archive' "\$@" || exit 1
else
	tar -czf '$archive' -C '$root' ./etc/mp716-upgrade/sysupgrade.pending || exit 1
fi
sysupgrade -f '$archive' $([ "$keep" -eq 0 ] && printf '%s' '-n ') '$payload'
rc=\$?
[ "\$rc" -ne 0 ] || exit 0
mkdir -p '$(dirname "$RESULT_FILE")'
printf '{"ok":false,"error":"sysupgrade","flash_write":false,"detail":"sysupgrade exit %s"}\n' "\$rc" > '$RESULT_FILE'
[ -n '${MP716_TEST_ROOT:-}' ] || {
	[ -z '${old_min:-}' ] || echo '${old_min:-}' > /proc/sys/vm/min_free_kbytes
	for s in uhttpd dnsmasq mp716-admin log sysntpd odhcpd urngd wpad cron miniupnpd mp716-vpn; do
		/etc/init.d/\$s start >/dev/null 2>&1 || true
	done
	wifi up >/dev/null 2>&1 || true
}
exit \$rc
EOF
		chmod 755 "$stage/run.sh"
		# The adapter test has to observe sysupgrade's own exit. On the router the
		# CGI must exit first, or the 64MB board reboots without writing.
		if [ -n "${MP716_TEST_ROOT:-}" ]; then
			set +e
			"$stage/run.sh"
			exit $?
		fi
		setsid "$stage/run.sh" >/tmp/sysupgrade-run.log 2>&1 </dev/null &
		exit 0
		;;
	*)
		usage
		;;
esac