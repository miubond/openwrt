#!/bin/sh
# Front door for sysupgrade on an OpenWrt image built for MP716.
# Installing this onto the vendor firmware does not make that firmware upgradable.
# Platform format and recovery must both be confirmed. Never calls mtd and never accepts -F.
set -eu

GATE_FILE="${MP716_GATE_FILE:-/etc/mp716-upgrade/flash-gate}"
PLATFORM_FILE="${MP716_PLATFORM_FILE:-/etc/mp716-upgrade/platform}"

usage() {
	echo "usage: mp716-sysupgrade identify|verify|plan|apply FILE [--keep-config]" >&2
	exit 1
}

for arg in "$@"; do
	case "$arg" in
		-F|--force|allow-flash-upgrade)
			printf '%s\n' '{"ok":false,"error":"flash_disabled","flash_write":false}'
			exit 24
			;;
	esac
done

[ "$#" -ge 2 ] && [ "$#" -le 3 ] || usage
cmd=$1
file=$2
keep=0
if [ "${3:-}" = "--keep-config" ]; then
	keep=1
elif [ -n "${3:-}" ]; then
	usage
fi

case "$file" in
	*".."*|*/dev/mtd*|*/dev/mtdblock*|*mtdblock*)
		printf '%s\n' '{"ok":false,"error":"path","flash_write":false}'
		exit 23
		;;
esac
case "$file" in
	/*) ;;
	*) file="./$file" ;;
esac
[ -f "$file" ] || {
	printf '%s\n' '{"ok":false,"error":"io","flash_write":false}'
	exit 2
}

if command -v hexdump >/dev/null 2>&1; then
	magic=$(hexdump -v -n 8 -e '1/1 "%02x"' "$file")
else
	magic=$(od -An -t x1 -N 8 "$file" | tr -d ' \n')
fi
kind=unknown
case "$magic" in
	4d50373136555044*) kind=custom ;;
	27051956*) kind=vendor ;;
esac

plan_command() {
	if [ "$keep" -eq 1 ]; then
		printf '%s\n' 'sysupgrade -f <config-and-pending-archive> <verified-payload>'
	else
		printf '%s\n' 'sysupgrade -n -f <pending-only-archive> <verified-payload>'
	fi
}

gate_open() {
	[ -f "$GATE_FILE" ] || return 1
	value=$(tr -d '\r\n' < "$GATE_FILE")
	[ "$value" = "serial-recovery-verified" ]
}

platform_confirmed() {
	[ -f "$PLATFORM_FILE" ] || return 1
	value=$(tr -d '\r\n' < "$PLATFORM_FILE")
	[ "$value" = "confirmed" ]
}

check_container() {
	case "$kind" in
		unknown)
			printf '%s\n' '{"ok":false,"error":"format","flash_write":false}'
			return 3
			;;
		vendor)
			printf '%s\n' '{"ok":false,"error":"vendor_image_not_audited","flash_write":false}'
			return 9
			;;
	esac
	if ! command -v mp716-upgraded >/dev/null 2>&1; then
		printf '%s\n' '{"ok":false,"error":"checker_missing","flash_write":false}'
		return 1
	fi
	mp716-upgraded check --image "$file" "$@"
}

case "$cmd" in
	identify)
		printf '{"ok":true,"kind":"%s","flash_write":false}\n' "$kind"
		;;
	verify)
		check_container
		;;
	plan)
		printf '{"ok":true,"kind":"%s","command":"%s","flash_write":false}\n' "$kind" "$(plan_command)"
		;;
	apply)
		if ! platform_confirmed; then
			printf '%s\n' '{"ok":false,"error":"platform_unconfirmed","flash_write":false}'
			exit 12
		fi
		if ! gate_open; then
			printf '%s\n' '{"ok":false,"error":"flash_disabled","flash_write":false}'
			exit 24
		fi
		stage=$(mktemp -d /tmp/mp716-sysupgrade.XXXXXX)
		payload="$stage/sysupgrade.bin"
		trap 'rm -rf -- "$stage"' EXIT
		trap 'exit 1' HUP INT TERM
		archive="$stage/config.tgz"
		root="$stage/root"
		check_container --extract "$payload" --pending-state "$stage/sysupgrade.pending"
		set -- "$payload"
		if [ "$keep" -eq 0 ]; then
			set -- -n "$@"
		fi
		sysupgrade -T "$@"
		mkdir "$root"
		if [ "$keep" -eq 1 ]; then
			sysupgrade -b "$archive"
			tar -xzf "$archive" -C "$root"
		fi
		mkdir -p "$root/etc/mp716-upgrade"
		mv -f "$stage/sysupgrade.pending" "$root/etc/mp716-upgrade/sysupgrade.pending"
		if [ "$keep" -eq 1 ]; then
			(
				cd "$root"
				set --
				for entry in ./* ./.[!.]* ./..?*; do
					[ -e "$entry" ] || [ -L "$entry" ] || continue
					set -- "$@" "$entry"
				done
				tar -czf "$archive" "$@"
			)
		else
			tar -czf "$archive" -C "$root" ./etc/mp716-upgrade/sysupgrade.pending
		fi
		# procd may consume the image after sysupgrade returns.
		trap - EXIT HUP INT TERM
		if sysupgrade -f "$archive" "$@"; then
			exit 0
		else
			status=$?
			rm -rf -- "$stage"
			exit "$status"
		fi
		;;
	*)
		usage
		;;
esac
