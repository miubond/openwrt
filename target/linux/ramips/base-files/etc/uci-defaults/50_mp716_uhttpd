#!/bin/sh
# 启用静态管理页与 CGI（不新增常驻服务）

[ -x /usr/sbin/uhttpd ] || exit 0

if ! uci -q get uhttpd.main.home | grep -q '/www'; then
	uci set uhttpd.main.home='/www'
fi

if ! uci -q get uhttpd.main.cgi_prefix >/dev/null; then
	uci add_list uhttpd.main.cgi_prefix='/cgi-bin'
fi

if ! uci -q get uhttpd.main.interpreter | grep -q "uc=/usr/bin/ucode"; then
	uci add_list uhttpd.main.interpreter='.uc=/usr/bin/ucode'
fi

# SPA 回退到 index.html
if ! uci -q get uhttpd.mp716 >/dev/null; then
	uci set uhttpd.mp716=uhttpd
	uci set uhttpd.mp716.listen_http='0.0.0.0:8080'
	uci set uhttpd.mp716.home='/www/mp716'
	uci set uhttpd.mp716.index_page='index.html'
fi

uci commit uhttpd
/etc/init.d/uhttpd enable

exit 0
